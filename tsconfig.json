{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node-ts/tsconfig.json"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": ["*.ts", "*.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
