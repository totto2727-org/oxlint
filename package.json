{
  "name": "@totto2727/oxlint",
  "version": "0.2.0",
  "description": "Custom Oxlint rules and preset for Effect-oriented TypeScript projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/oxlint.git"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./preset/application": {
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./preset/library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.87.0",
    "effect": "^4.0.2",
    "oxlint": "^1.87.0",
    "typescript-api": "npm:typescript@^6.0.3"
  },
  "devDependencies": {
    "@totto2727/gitignore-patterns": "^0.1.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.1.0",
    "vite-plus": "^1.1.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
